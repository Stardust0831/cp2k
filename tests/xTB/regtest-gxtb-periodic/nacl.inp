&GLOBAL
  PROJECT nacl
  RUN_TYPE ENERGY_FORCE
&END GLOBAL
&FORCE_EVAL
  METHOD GXTB
  STRESS_TENSOR ANALYTICAL
  &SUBSYS
    &CELL
      A 7.2 0.0 0.0
      B 0.36 7.4 0.0
      C 0.45 0.18 7.0
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Na 0.05 0.04 0.03
      Cl 0.47 0.51 0.49
    &END COORD
    &TOPOLOGY
      CONNECTIVITY OFF
    &END TOPOLOGY
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
