&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT si8
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 100
    &END MGRID
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 200
      SCF_GUESS ATOMIC
      &OT
        ENERGY_GAP 0.001
        MINIMIZER DIIS
        PRECONDITIONER FULL_KINETIC
        PRECOND_SOLVER CUDSS
      &END OT
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 5.42858871335 5.42858871335 5.42858871335
      PERIODIC XYZ
    &END CELL
    &COORD
      Si       0.00000       0.00000       0.00000
      Si       1.35715       1.35715       1.35715
      Si       0.00000       2.71429       2.71429
      Si       1.35715       4.07144       4.07144
      Si       2.71429       0.00000       2.71429
      Si       4.07144       1.35715       4.07144
      Si       2.71429       2.71429       0.00000
      Si       4.07144       4.07144       1.35715
    &END COORD
    &KIND Si
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
