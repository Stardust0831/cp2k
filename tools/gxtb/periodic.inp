&GLOBAL
  PROJECT periodic-gxtb
  RUN_TYPE ENERGY_FORCE
&END GLOBAL
&MOTION
  &DRIVER
    UNIX
    PREFIX ipi
    HOST gxtb
  &END DRIVER
&END MOTION
&FORCE_EVAL
  METHOD IPI
  STRESS_TENSOR ANALYTICAL
  &SUBSYS
    &CELL
      A 14.0 0.0 0.0
      B 0.5 14.2 0.0
      C 0.7 0.3 13.8
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME water.xyz
      COORD_FILE_FORMAT XYZ
      CONNECTIVITY OFF
    &END TOPOLOGY
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
